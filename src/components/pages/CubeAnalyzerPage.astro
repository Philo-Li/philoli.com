---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import CubeAnalyzer from '../cube-analyzer/CubeAnalyzer.tsx';
import { DEFAULT_LOCALE, isLocale, localizedPath, useTranslations } from '../../i18n';

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : DEFAULT_LOCALE;
const t = useTranslations(locale);
const allPosts = await getCollection('blog');
const tutorialSlug = 'solve-rubiks-cube-without-formulas';
const tutorialPost = allPosts.find(post => post.id === `${locale}/${tutorialSlug}`)
  ?? allPosts.find(post => post.id === `${DEFAULT_LOCALE}/${tutorialSlug}`)
  ?? allPosts.find(post => post.id === `zh/${tutorialSlug}`);
const tutorialLocale = tutorialPost?.id.split('/')[0];
const tutorialHref = tutorialPost && tutorialLocale && isLocale(tutorialLocale)
  ? localizedPath(`/blog/${tutorialSlug}`, tutorialLocale)
  : null;
---

<BaseLayout
  title={t('metadata.cubeAnalyzerTitle')}
  description={t('metadata.cubeAnalyzerDescription')}
>
  <CubeAnalyzer
    client:only="react"
    locale={locale}
    sampleUrl="/data/cube-analyzer-sample.json"
    cubeHref={localizedPath('/projects/rubiks-cube', locale)}
    tutorial={tutorialPost && tutorialHref ? { title: tutorialPost.data.title, href: tutorialHref } : null}
  />
</BaseLayout>
